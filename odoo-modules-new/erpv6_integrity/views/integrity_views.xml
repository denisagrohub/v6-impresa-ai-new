<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integrity_form" model="ir.ui.view">
        <field name="name">erpv6.integrity.check.form</field><field name="model">erpv6.integrity.check</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="check_integrity" type="object" string="Esegui Verifica" class="oe_highlight"/></header>
                <sheet><group><field name="last_check"/><field name="status" widget="badge"/><field name="details"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_integrity" model="ir.actions.act_window">
        <field name="name">Integrita</field><field name="res_model">erpv6.integrity.check</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_system" name="Sistema" parent="erpv6_core.menu_erpv6_root" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_integrity" name="Integrita" parent="menu_system" action="action_integrity" sequence="10"/>
</odoo>
