<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_list" model="ir.ui.view">
        <field name="name">erpv6.tracking.lot.list</field>
        <field name="model">erpv6.tracking.lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/><field name="name"/><field name="product_id"/>
                <field name="brand_id"/><field name="quantity"/><field name="production_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_lot_form" model="ir.ui.view">
        <field name="name">erpv6.tracking.lot.form</field>
        <field name="model">erpv6.tracking.lot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Attiva" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Chiudi" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <group><group><field name="code"/><field name="name"/><field name="tracking_type"/></group>
                    <group><field name="company_id"/><field name="brand_id"/><field name="product_id"/></group></group>
                    <group><field name="quantity"/><field name="production_date"/><field name="notes"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lot" model="ir.actions.act_window">
        <field name="name">Lotti</field><field name="res_model">erpv6.tracking.lot</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_tracking" name="Tracciamento" parent="erpv6_core.menu_erpv6_root" sequence="50"/>
    <menuitem id="menu_lots" name="Lotti" parent="menu_tracking" action="action_lot" sequence="10"/>
</odoo>
