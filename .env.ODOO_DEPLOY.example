# Configurazione deploy Odoo su VPS Aruba
# Copia questo file in .env.ODOO_DEPLOY e compila i valori

# Credenziali SSH del VPS
VPS_USER=root
VPS_HOST=xxx.xxx.xxx.xxx
VPS_SSH_PORT=22
VPS_SSH_KEY=~/.ssh/id_rsa  # Opzionale: path alla chiave privata

# Configurazione Odoo sul VPS
ODOO_ADDONS_PATH=/opt/odoo/custom_addons
ODOO_SERVICE=odoo
ODOO_USER=odoo