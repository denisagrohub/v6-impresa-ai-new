# ================================================================
# V6 IMPRESA AI - INTEGRAZIONI
# ================================================================

# ---- ODOO (produzione) ----
ODOO_URL=https://tuo-vps.it:8069
ODOO_DB=nome_database
ODOO_USERNAME=admin
ODOO_PASSWORD=password
ODOO_ACTIVE=true
ODOO_MOCK=true  # true = usa mock, false = usa Odoo reale

# ---- AI PROVIDERS ----
DAILY_API_KEY=your-daily-key
DEEPGRAM_API_KEY=your-deepgram-key
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-pinecone-env

# ---- FEATURE FLAGS ----
ENABLE_AI_COPILOT=true
ENABLE_REAL_TIME_COLLAB=true
ENABLE_SMART_SCORING=true
ENABLE_VOICE_TO_BP=true
ENABLE_BLOCKCHAIN_CERT=true
ENABLE_PREMIUM=true

# ---- MONITORING ----
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
