<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_config_form" model="ir.ui.view">
        <field name="name">erpv6.sign.config.form</field>
        <field name="model">erpv6.sign.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione Firma">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="opensign_url"/>
                        <field name="api_key" password="True"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_sign_config" model="ir.actions.act_window">
        <field name="name">Configurazione</field>
        <field name="res_model">erpv6.sign.config</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_erpv6_sign_config" name="Configurazione" parent="menu_erpv6_sign_root" action="action_sign_config" sequence="80" groups="base.group_system"/>
</odoo>
