<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template email notifica firma -->
        <record id="email_sign_notification" model="mail.template">
            <field name="name">Notifica Firma Documento</field>
            <field name="model_id" ref="model_erpv6_sign_request"/>
            <field name="subject">✍️ Richiesta Firma: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;max-width:600px;">
                    <h2 style="color:#1a2744;">✍️ Richiesta di Firma</h2>
                    <p>Gentile <strong>{{ object.partner_id.name }}</strong>,</p>
                    <p>Sei stato richiesto di firmare il documento: <strong>{{ object.name }}</strong></p>
                    <p>Clicca sul link seguente per procedere alla firma:</p>
                    <p><a href="{{ object.request_url }}" style="background:#ed8936;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;">Firma Documento</a></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
