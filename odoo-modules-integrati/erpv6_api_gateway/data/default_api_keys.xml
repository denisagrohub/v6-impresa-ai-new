<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
    <record id="apikey_nextjs" model="erpv6.api.key">
        <field name="name">Next.js Frontend</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="is_active" eval="True"/>
        <field name="allowed_endpoints">/api/v1/*</field>
        <field name="rate_limit_per_minute">120</field>
    </record>
    <record id="apikey_ai" model="erpv6.api.key">
        <field name="name">AI Agent</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="is_active" eval="True"/>
        <field name="allowed_endpoints">/api/v1/ai/*,/api/v1/kb/*</field>
        <field name="rate_limit_per_minute">60</field>
    </record>
</data></odoo>
