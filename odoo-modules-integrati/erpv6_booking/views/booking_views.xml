<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_token_list" model="ir.ui.view">
        <field name="name">erpv6.booking.token.list</field>
        <field name="model">erpv6.booking.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="token"/><field name="consultant_id"/><field name="brand_id"/>
                <field name="status" widget="badge"/><field name="client_name"/>
                <field name="expires_at"/><field name="booked_at"/>
            </list>
        </field>
    </record>
    <record id="view_token_form" model="ir.ui.view">
        <field name="name">erpv6.booking.token.form</field>
        <field name="model">erpv6.booking.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_book" type="object" string="Prenota" class="oe_highlight" invisible="status != 'available'"/>
                    <button name="action_cancel" type="object" string="Cancella" invisible="status not in ['available','booked']"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,booked"/>
                </header>
                <sheet>
                    <group><group><field name="token"/><field name="consultant_id"/><field name="brand_id"/></group>
                    <group><field name="validity_hours"/><field name="expires_at"/><field name="booked_at"/></group></group>
                    <group string="Cliente" invisible="status == 'available'">
                        <field name="client_name"/><field name="client_email"/><field name="client_phone"/><field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_token" model="ir.actions.act_window">
        <field name="name">Token</field><field name="res_model">erpv6.booking.token</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_booking" name="Prenotazioni" parent="erpv6_core.menu_erpv6_root" sequence="30"/>
    <menuitem id="menu_tokens" name="Token" parent="menu_booking" action="action_token" sequence="10"/>
</odoo>
