<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blockchain_record_tree" model="ir.ui.view">
        <field name="name">erpv6.blockchain.record.tree</field>
        <field name="model">erpv6.blockchain.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="document_name"/>
                <field name="tx_hash"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    
    <record id="action_blockchain_record" model="ir.actions.act_window">
        <field name="name">Record Blockchain</field>
        <field name="res_model">erpv6.blockchain.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
