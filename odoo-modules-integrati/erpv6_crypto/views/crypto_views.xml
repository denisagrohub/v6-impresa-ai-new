<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_erpv6_crypto_audit" model="ir.actions.act_window">
        <field name="name">Audit Crittografia</field>
        <field name="res_model">erpv6.crypto.audit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_crypto_audit_list" model="ir.ui.view">
        <field name="name">erpv6.crypto.audit.list</field>
        <field name="model">erpv6.crypto.audit</field>
        <field name="arch" type="xml">
            <list string="Audit" create="0" edit="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="operation" widget="badge"/>
                <field name="context"/>
                <field name="data_length"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>
    <menuitem id="menu_erpv6_crypto_root" name="Sicurezza e Crypto"
              parent="erpv6_core.menu_erpv6_root" sequence="80" groups="base.group_system"/>
    <menuitem id="menu_erpv6_crypto_audit" name="Log Audit"
              parent="menu_erpv6_crypto_root" action="action_erpv6_crypto_audit" sequence="10"/>
</odoo>
