<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_typst_document_form" model="ir.ui.view">
        <field name="name">erpv6.typst.document.form</field>
        <field name="model">erpv6.typst.document</field>
        <field name="arch" type="xml">
            <form string="Documento Generato">
                <header>
                    <button name="action_generate" string="Genera PDF" type="object" class="oe_highlight" invisible="file_content"/>
                    <button name="action_send_to_sign" string="Invia per Firma" type="object" invisible="not file_content"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,generated,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="file_content" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_size"/>
                        </group>
                    </group>
                    <group string="Blockchain">
                        <field name="blockchain_hash"/>
                        <field name="blockchain_verified"/>
                    </group>
                    <group string="Dati">
                        <field name="data" nolabel="1" widget="text"/>
                    </group>
                    <group string="Note">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_typst_document_list" model="ir.ui.view">
        <field name="name">erpv6.typst.document.list</field>
        <field name="model">erpv6.typst.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_id"/>
                <field name="res_model"/>
                <field name="status"/>
                <field name="file_size"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    
    <record id="action_typst_document" model="ir.actions.act_window">
        <field name="name">Documenti Generati</field>
        <field name="res_model">erpv6.typst.document</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_erpv6_typst_documents" name="Documenti" parent="menu_erpv6_typst_root" action="action_typst_document" sequence="20"/>
</odoo>
