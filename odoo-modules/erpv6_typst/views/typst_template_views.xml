<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List per Template -->
    <record id="view_erpv6_typst_template_list" model="ir.ui.view">
        <field name="name">erpv6.typst.template.list</field>
        <field name="model">erpv6.typst.template</field>
        <field name="arch" type="xml">
            <list string="Template Tipst">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="language"/>
                <field name="version"/>
                <field name="usage_count"/>
                <field name="last_used"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista Form per Template -->
    <record id="view_erpv6_typst_template_form" model="ir.ui.view">
        <field name="name">erpv6.typst.template.form</field>
        <field name="model">erpv6.typst.template</field>
        <field name="arch" type="xml">
            <form string="Template Tipst">
                <header>
                    <button name="action_preview_source" type="object" string="Anteprima Sorgente" class="btn-secondary" icon="fa-eye"/>
                    <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_erpv6_typst_document)d" type="action" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="usage_count" widget="statinfo" string="Documenti Generati"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <label for="code" class="oe_edit_only"/>
                        <h2><field name="code"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="language"/>
                            <field name="version"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="page_size"/>
                            <field name="orientation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrizione">
                            <field name="description" placeholder="Descrizione del template..."/>
                        </page>
                        <page string="Sorgente Typst" name="sorgente_typst">
                            <field name="typst_source" placeholder="#let data = json(&quot;data.json&quot;)..." options='{"font": "monospace"}'/>
                        </page>
                        <page string="Campi Richiesti" name="campi_richiesti">
                            <field name="required_fields" widget="json" options='{"mode": "editor"}'/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search per Template -->
    <record id="view_erpv6_typst_template_search" model="ir.ui.view">
        <field name="name">erpv6.typst.template.search</field>
        <field name="model">erpv6.typst.template</field>
        <field name="arch" type="xml">
            <search string="Cerca Template">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="language"/>
                <filter string="Attivi" name="active" domain="[('active','=',True)]"/>
                <filter string="Non Attivi" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Categoria" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Lingua" name="group_language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action per Template -->
    <record id="action_erpv6_typst_template" model="ir.actions.act_window">
        <field name="name">Template Tipst</field>
        <field name="res_model">erpv6.typst.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erpv6_typst_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea il tuo primo template Tipst
            </p>
            <p>
                I template definiscono la struttura dei documenti PDF (Business Plan, Report, ecc.)
            </p>
        </field>
    </record>
</odoo>
