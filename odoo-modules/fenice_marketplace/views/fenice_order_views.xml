<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_fenice" model="ir.ui.view">
        <field name="name">sale.order.form.fenice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Fenice Commissioni" name="fenice_commission">
                    <group>
                        <group>
                            <field name="fenice_vendor_id"/>
                            <field name="fenice_commission_amount"/>
                        </group>
                        <group>
                            <field name="fenice_vendor_amount"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
