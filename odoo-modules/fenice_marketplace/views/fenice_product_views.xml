<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_fenice" model="ir.ui.view">
        <field name="name">product.template.form.fenice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Fenice Marketplace" name="fenice_marketplace">
                    <group>
                        <field name="fenice_vendor_id"/>
                        <field name="fenice_categoria"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
