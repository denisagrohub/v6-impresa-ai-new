<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_typst_template_form" model="ir.ui.view">
        <field name="name">erpv6.typst.template.form</field>
        <field name="model">erpv6.typst.template</field>
        <field name="arch" type="xml">
            <form string="Template Typst">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome Template"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_type"/>
                            <field name="brand_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="usage_count"/>
                        </group>
                    </group>
                    <group string="Contenuto Template Typst">
                        <field name="template_content" nolabel="1" widget="text"/>
                    </group>
                    <group string="Variabili Disponibili">
                        <field name="variables" nolabel="1" widget="text"/>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_typst_template_list" model="ir.ui.view">
        <field name="name">erpv6.typst.template.list</field>
        <field name="model">erpv6.typst.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_type"/>
                <field name="brand_id"/>
                <field name="usage_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <record id="action_typst_template" model="ir.actions.act_window">
        <field name="name">Template Typst</field>
        <field name="res_model">erpv6.typst.template</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_erpv6_typst_templates" name="Template" parent="menu_erpv6_typst_root" action="action_typst_template" sequence="10"/>
</odoo>
