<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Brand Progetto Impresa -->
        <record id="brand_progetto_impresa" model="erpv6.consulting.brand">
            <field name="name">Progetto Impresa</field>
            <field name="code">PI</field>
            <field name="color">#1a2744</field>
            <field name="default_hourly_rate">180.0</field>
            <field name="default_commission_rate">35.0</field>
            <field name="default_max_discount">10</field>
            <field name="active" eval="True"/>
            <field name="description">Brand principale per business plan e consulenza strategica</field>
        </record>

        <!-- Brand Zero Sprechi -->
        <record id="brand_zero_sprechi" model="erpv6.consulting.brand">
            <field name="name">Zero Sprechi</field>
            <field name="code">ZS</field>
            <field name="color">#059669</field>
            <field name="default_hourly_rate">150.0</field>
            <field name="default_commission_rate">25.0</field>
            <field name="default_max_discount">8</field>
            <field name="active" eval="True"/>
            <field name="description">Brand per sostenibilità e riduzione sprechi</field>
        </record>

        <!-- Brand Manuale Rapido -->
        <record id="brand_manuale_rapido" model="erpv6.consulting.brand">
            <field name="name">Manuale Rapido</field>
            <field name="code">MR</field>
            <field name="color">#f97316</field>
            <field name="default_hourly_rate">120.0</field>
            <field name="default_commission_rate">20.0</field>
            <field name="default_max_discount">5</field>
            <field name="active" eval="True"/>
            <field name="description">Brand per documentazione tecnica e procedure</field>
        </record>
    </data>
</odoo>