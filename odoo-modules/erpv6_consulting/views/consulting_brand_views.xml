<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consulting_brand_form" model="ir.ui.view">
        <field name="name">erpv6.consulting.brand.form</field>
        <field name="model">erpv6.consulting.brand</field>
        <field name="arch" type="xml">
            <form string="Brand di Consulting">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome Brand"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dati Base">
                            <field name="code"/>
                            <field name="active"/>
                            <field name="color" widget="color"/>
                            <field name="logo_url"/>
                        </group>
                        <group string="Valori Default">
                            <field name="default_hourly_rate"/>
                            <field name="default_commission_rate"/>
                            <field name="default_max_discount"/>
                        </group>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_consulting_brand_tree" model="ir.ui.view">
        <field name="name">erpv6.consulting.brand.tree</field>
        <field name="model">erpv6.consulting.brand</field>
        <field name="arch" type="xml">
            <tree string="Brand di Consulting">
                <field name="name"/>
                <field name="code"/>
                <field name="default_hourly_rate"/>
                <field name="default_commission_rate"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_consulting_brand" model="ir.actions.act_window">
        <field name="name">Brand di Consulting</field>
        <field name="res_model">erpv6.consulting.brand</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>