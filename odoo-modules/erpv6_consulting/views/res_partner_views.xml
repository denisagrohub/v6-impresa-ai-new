<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_consulting" model="ir.ui.view">
        <field name="name">res.partner.form.consulting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Consulting" name="consulting" invisible="not x_is_consultant and not x_is_referral">
                        <group>
                            <group string="Ruolo">
                                <field name="x_is_consultant"/>
                                <field name="x_is_referral"/>
                                <field name="x_consultant_status"/>
                                <field name="x_onboarding_date"/>
                            </group>
                            <group string="Brand">
                                <field name="x_brand_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Configurazione Economica" invisible="not x_is_consultant">
                            <group>
                                <field name="x_contract_type"/>
                                <field name="x_hourly_rate"/>
                                <field name="x_commission_rate"/>
                                <field name="x_max_discount"/>
                            </group>
                            <group>
                                <field name="x_fixed_fee" invisible="x_contract_type != 'fixed' and x_contract_type != 'fixed_plus_percentage'"/>
                                <field name="x_specialties"/>
                            </group>
                        </group>
                        <group string="Tracciamento">
                            <field name="batch_lot_id"/>
                            <field name="definitive_lot_id"/>
                            <field name="tracking_enabled"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_consulting" model="ir.ui.view">
        <field name="name">res.partner.tree.consulting</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="x_is_consultant" optional="hide"/>
                <field name="x_is_referral" optional="hide"/>
                <field name="x_consultant_status" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_consultants" model="ir.actions.act_window">
        <field name="name">Consulenti</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('x_is_consultant', '=', True)]</field>
        <field name="context">{'default_x_is_consultant': True}</field>
    </record>

    <record id="action_referrals" model="ir.actions.act_window">
        <field name="name">Referral</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('x_is_referral', '=', True)]</field>
        <field name="context">{'default_x_is_referral': True}</field>
    </record>
</odoo>