<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_signal_sync" model="ir.cron">
            <field name="name">C5: Sync signals da sorgenti</field>
            <field name="model_id" ref="model_erpv6_signal"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_signals()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
