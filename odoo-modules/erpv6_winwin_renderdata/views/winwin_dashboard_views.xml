<odoo>
    <record id="action_winwin_consultant_dashboard" model="ir.actions.client">
        <field name="name">Dashboard Consulente Win-Win</field>
        <field name="tag">winwin_consultant_dashboard</field>
    </record>

    <record id="view_winwin_email_log_tree" model="ir.ui.view">
        <field name="name">erpv6.winwin.email.log.tree</field>
        <field name="model">erpv6.winwin.email.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="sender_email"/>
                <field name="name"/>
                <field name="relation_id"/>
                <field name="match_status"/>
            </list>
        </field>
    </record>

    <record id="view_winwin_email_log_form" model="ir.ui.view">
        <field name="name">erpv6.winwin.email.log.form</field>
        <field name="model">erpv6.winwin.email.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sender_email"/>
                        <field name="recipient_emails"/>
                        <field name="cc_emails"/>
                    </group>
                    <group>
                        <field name="match_status"/>
                        <field name="matched_alias"/>
                        <field name="relation_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_winwin_email_log" model="ir.actions.act_window">
        <field name="name">Email Progetti Win-Win</field>
        <field name="res_model">erpv6.winwin.email.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_winwin_dashboard_root" name="Dashboard Consulente" sequence="95"/>
    <menuitem id="menu_winwin_dashboard" name="Dashboard" parent="menu_winwin_dashboard_root"
              action="action_winwin_consultant_dashboard" sequence="10"/>
    <menuitem id="menu_winwin_email_log" name="Email Progetti" parent="menu_winwin_dashboard_root"
              action="action_winwin_email_log" sequence="20"/>
</odoo>
