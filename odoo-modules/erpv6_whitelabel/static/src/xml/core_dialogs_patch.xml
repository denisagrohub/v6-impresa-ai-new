<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">ERPV6 Session Expired</attribute>
        </xpath>
        <xpath expr="//p[contains(text(),'Your Odoo session expired')]" position="replace">
            <p class="text-prewrap">
                Your ERPV6 session expired. The current page is about to be refreshed.
            </p>
        </xpath>
    </t>

    <t t-inherit="web.NotificationAlert" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('alert-primary')]" position="replace">
            <div t-if="isNotificationBlocked" class="alert alert-primary text-center">
                ERPV6 Push notifications have been blocked. Go to your browser settings to allow them.
            </div>
        </xpath>
    </t>

</templates>
