<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- "OdooBot" come nome autore nella chat AI (Ask AI / ChatGPT). Esistono
         due template quasi identici per due motori editor diversi entrambi
         installati (html_editor e web_editor): patchiamo entrambi. -->
    <t t-inherit="html_editor.ChatGPTPromptDialog" t-inherit-mode="extension">
        <xpath expr="//t[contains(@t-esc,'OdooBot')]" position="attributes">
            <attribute name="t-esc">message.author === 'user' ? 'You' : 'ERPV6 Bot'</attribute>
        </xpath>
    </t>

    <t t-inherit="web_editor.ChatGPTPromptDialog" t-inherit-mode="extension">
        <xpath expr="//t[contains(@t-esc,'OdooBot')]" position="attributes">
            <attribute name="t-esc">message.author === 'user' ? 'You' : 'ERPV6 Bot'</attribute>
        </xpath>
    </t>

</templates>
