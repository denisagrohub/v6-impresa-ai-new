<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Titolo della tab del browser: fallback "Odoo" -> "ERPV6" -->
    <template id="white_label_page_title" inherit_id="web.layout">
        <xpath expr="//title" position="attributes">
            <attribute name="t-esc">title or 'ERPV6'</attribute>
        </xpath>
    </template>

    <!-- Titolo di default dei report PDF -->
    <template id="white_label_report_title" inherit_id="web.report_layout">
        <xpath expr="//title" position="replace">
            <title><t t-esc="title or 'ERPV6 Report'"/></title>
        </xpath>
    </template>

    <template id="white_label_report_preview_title" inherit_id="web.report_preview_layout">
        <xpath expr="//title" position="replace">
            <title><t t-esc="title or 'ERPV6 Report'"/></title>
        </xpath>
    </template>

    <!-- Pagina "sei offline" -->
    <template id="white_label_offline_page" inherit_id="web.webclient_offline">
        <xpath expr="//div[hasclass('card')]/img" position="attributes">
            <attribute name="alt">ERPV6 logo</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card')]/p" position="replace">
            <p>Check your network connection and come back here. ERPV6 will load as soon as you're back online.</p>
        </xpath>
    </template>

    <!-- Placeholder nome App PWA in Impostazioni Generali -->
    <template id="white_label_pwa_name_placeholder" inherit_id="base_setup.res_config_settings_view_form">
        <xpath expr="//field[@name='web_app_name']" position="attributes">
            <attribute name="placeholder">ERPV6</attribute>
        </xpath>
    </template>

    <!-- Footer login: "Powered by Odoo" -> "Powered by ERPV6".
         L'unica dicitura "Powered by Odoo Community Edition" richiesta resta
         in Impostazioni > Informazioni (vedi static/src/xml/res_config_edition_patch.xml). -->
    <template id="white_label_login_footer" inherit_id="web.login_layout">
        <xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']/span" position="replace">
            <span>ERPV6</span>
        </xpath>
    </template>

    <!-- Email: reset password -->
    <template id="white_label_reset_password_email" inherit_id="auth_signup.reset_password_email">
        <xpath expr="//td[@valign='top']/div" position="replace">
            <div>
                Dear <t t-out="object.name or ''">Marc Demo</t>,<br/><br/>
                A password reset was requested for the ERPV6 account linked to this email.
                You may change your password by following this link which will remain valid during <t t-out="user.env['ir.config_parameter'].sudo().get_param('auth_signup.reset_password.validity.hours',4)"></t> hours:<br/>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.partner_id._get_signup_url()"
                        style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        Change password
                    </a>
                </div>
                If you do not expect this, you can safely ignore this email.<br/><br/>
                Thanks,
                <t t-if="user.signature">
                    <br/>
                    <t t-out="user.signature">--<br/>Mitchell Admin</t>
                </t>
            </div>
        </xpath>
        <xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']" position="replace">
            <a target="_blank" href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" style="color: #875A7B;">ERPV6</a>
        </xpath>
    </template>

    <!-- Email: alert nuovo device (solo footer "Powered by") -->
    <template id="white_label_alert_login_new_device" inherit_id="auth_signup.alert_login_new_device">
        <xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']" position="replace">
            <a target="_blank" href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" style="color: #875A7B;">ERPV6</a>
        </xpath>
    </template>

</odoo>
