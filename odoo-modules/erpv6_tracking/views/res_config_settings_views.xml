<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estensione impostazioni di configurazione per la tracciabilità -->
    <!-- App dedicata V6 Impresa AI con sezione Tracciabilità -->
    <record id="res_config_settings_view_form_tracking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base']" position="after">
                <app string="V6 Impresa AI" name="erpv6_settings">
                    <block title="Tracciabilità" name="tracking_settings_block">
                        <setting id="tracking_product_setting" string="Tracciabilità Prodotti">
                            <div class="content-group">
                                <field name="tracking_enabled_product"/>
                            </div>
                        </setting>
                        <setting id="tracking_document_setting" string="Tracciabilità Documenti">
                            <div class="content-group">
                                <field name="tracking_enabled_document"/>
                            </div>
                        </setting>
                        <setting id="tracking_project_setting" string="Tracciabilità Progetti">
                            <div class="content-group">
                                <field name="tracking_enabled_project"/>
                            </div>
                        </setting>
                        <setting id="tracking_order_setting" string="Tracciabilità Ordini">
                            <div class="content-group">
                                <field name="tracking_enabled_order"/>
                            </div>
                        </setting>
                        <setting id="tracking_custom_setting" string="Tracciabilità Custom">
                            <div class="content-group">
                                <field name="tracking_enabled_custom"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
