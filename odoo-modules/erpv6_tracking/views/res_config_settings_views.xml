<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estensione impostazioni di configurazione per la tracciabilità -->
    <record id="res_config_settings_view_form_tracking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base']" position="inside">
                <block title="Tracciabilità" name="tracking_settings">
                    <setting id="tracking_product_setting" string="Prodotti">
                        <div class="content-group">
                            <field name="tracking_enabled_product"/>
                        </div>
                    </setting>
                    <setting id="tracking_document_setting" string="Documenti">
                        <div class="content-group">
                            <field name="tracking_enabled_document"/>
                        </div>
                    </setting>
                    <setting id="tracking_project_setting" string="Progetti">
                        <div class="content-group">
                            <field name="tracking_enabled_project"/>
                        </div>
                    </setting>
                    <setting id="tracking_order_setting" string="Ordini">
                        <div class="content-group">
                            <field name="tracking_enabled_order"/>
                        </div>
                    </setting>
                    <setting id="tracking_custom_setting" string="Custom">
                        <div class="content-group">
                            <field name="tracking_enabled_custom"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
