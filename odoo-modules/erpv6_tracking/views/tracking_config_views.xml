<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tracking_config_form" model="ir.ui.view">
        <field name="name">erpv6.tracking.config.form</field>
        <field name="model">erpv6.tracking.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione Tracciamento">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome Configurazione"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dati Base">
                            <field name="code"/>
                            <field name="tracking_types"/>
                            <field name="active"/>
                        </group>
                        <group string="Azienda e Brand">
                            <field name="company_code"/>
                            <field name="default_brand"/>
                        </group>
                    </group>
                    <group string="Tipologie Lotto">
                        <group>
                            <field name="use_batch_lot"/>
                            <field name="use_definitive_lot"/>
                        </group>
                        <group>
                            <field name="use_julian_day"/>
                            <field name="include_time"/>
                        </group>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_tracking_config_tree" model="ir.ui.view">
        <field name="name">erpv6.tracking.config.tree</field>
        <field name="model">erpv6.tracking.config</field>
        <field name="arch" type="xml">
            <tree string="Configurazioni Tracciamento">
                <field name="name"/>
                <field name="code"/>
                <field name="tracking_types"/>
                <field name="company_code"/>
                <field name="default_brand"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    
    <record id="action_tracking_config" model="ir.actions.act_window">
        <field name="name">Configurazioni Tracciamento</field>
        <field name="res_model">erpv6.tracking.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la prima configurazione di tracciamento
            </p>
        </field>
    </record>
</odoo>