<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_erpv6_vertical_catalog_form" model="ir.ui.view">
        <field name="name">erpv6.vertical.catalog.form</field>
        <field name="model">erpv6.vertical.catalog</field>
        <field name="arch" type="xml">
            <form string="Catalogo Verticali">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informazioni">
                            <field name="verticale"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Moduli">
                            <field name="module_names"/>
                        </group>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_erpv6_vertical_catalog_list" model="ir.ui.view">
        <field name="name">erpv6.vertical.catalog.list</field>
        <field name="model">erpv6.vertical.catalog</field>
        <field name="arch" type="xml">
            <list string="Catalogo Verticali">
                <field name="verticale"/>
                <field name="name"/>
                <field name="module_names"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_erpv6_vertical_catalog" model="ir.actions.act_window">
        <field name="name">Catalogo Verticali</field>
        <field name="res_model">erpv6.vertical.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea il primo verticale
            </p>
            <p>
                Definisci i verticali disponibili e i moduli associati.
            </p>
        </field>
    </record>

    <!-- Menu sotto erpv6_core.menu_erpv6_root -->
    <menuitem id="menu_erpv6_vertical_catalog"
              name="Catalogo Verticali"
              parent="erpv6_core.menu_erpv6_root"
              action="action_erpv6_vertical_catalog"
              sequence="20"/>
</odoo>
