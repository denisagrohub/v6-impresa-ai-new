<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_log_list" model="ir.ui.view">
        <field name="name">erpv6.sign.log.list</field>
        <field name="model">erpv6.sign.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="request_id"/>
                <field name="action"/>
                <field name="details"/>
            </list>
        </field>
    </record>
    
    <record id="action_sign_log" model="ir.actions.act_window">
        <field name="name">Log Firma</field>
        <field name="res_model">erpv6.sign.log</field>
        <field name="view_mode">list</field>
    </record>
    
    <menuitem id="menu_erpv6_sign_logs" name="Log" parent="menu_erpv6_sign_root" action="action_sign_log" sequence="20"/>
</odoo>
