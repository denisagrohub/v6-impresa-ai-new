<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_install_opensign_wizard" model="ir.ui.view">
        <field name="name">erpv6.sign.install.wizard.form</field>
        <field name="model">erpv6.sign.install.wizard</field>
        <field name="arch" type="xml">
            <form string="Installazione OpenSign">
                <group invisible="state != 'check'">
                    <p>Questo wizard installerà OpenSign sul server.</p>
                </group>
                <group invisible="state != 'install'">
                    <field name="log" nolabel="1" widget="text"/>
                </group>
                <group invisible="state != 'done'">
                    <p>✅ OpenSign installato con successo!</p>
                </group>
                <footer>
                    <button name="action_install" string="Installa" type="object" class="oe_highlight" invisible="state != 'check'"/>
                    <button string="Chiudi" class="btn-secondary" special="cancel" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_install_opensign" model="ir.actions.act_window">
        <field name="name">Installa OpenSign</field>
        <field name="res_model">erpv6.sign.install.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
