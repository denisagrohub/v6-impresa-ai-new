<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_calendar_event_form_v6" model="ir.ui.view">
            <field name="name">calendar.event.form.v6_ext</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="V6" name="page_v6">
                        <group>
                            <group>
                                <field name="relation_id"/>
                                <field name="deal_id"/>
                            </group>
                            <group>
                                <field name="booking_token_id"/>
                                <field name="telegram_reminder_sent_at"/>
                                <field name="external_invite_sent_at"/>
                            </group>
                        </group>
                        <group>
                            <field name="external_attendees"
                                   placeholder="email1@example.com, email2@example.com"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
