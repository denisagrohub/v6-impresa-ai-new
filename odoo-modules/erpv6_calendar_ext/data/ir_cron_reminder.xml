<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 03/10/2026 (D.3b): Odoo 18 ha rimosso doall/numbercall da
             ir.cron. I campi name/model_id/state/code sono delegati a
             ir.actions.server via ir_actions_server_id (delegate=True).
             nextcall e user_id sono obbligatori. -->

        <record id="cron_telegram_reminder" model="ir.cron">
            <field name="name">V6 Agenda — Reminder Telegram 2h prima</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_telegram_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
