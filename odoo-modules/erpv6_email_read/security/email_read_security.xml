<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 02/10/2026 (C2-rd): ogni utente vede solo le proprie righe
             di lettura. Admin/chief bypassano (group_system non ha
             la rule applicata). -->
        <record id="rule_email_read_state_own" model="ir.rule">
            <field name="name">Email read state: vede solo i propri</field>
            <field name="model_id" ref="model_erpv6_email_read_state"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
