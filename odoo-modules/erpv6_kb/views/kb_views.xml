<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kb_list" model="ir.ui.view">
        <field name="name">erpv6.kb.list</field><field name="model">erpv6.kb</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name"/><field name="kb_type" widget="badge"/><field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/><field name="priority"/>
                <field name="access_level" widget="badge"/><field name="is_encrypted" widget="boolean_toggle"/>
                <field name="use_count"/><field name="version"/><field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_kb_form" model="ir.ui.view">
        <field name="name">erpv6.kb.form</field><field name="model">erpv6.kb</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_pending_prompt" type="object" string="Approva Modifica Prompt"
                            class="oe_highlight" groups="base.group_system"
                            invisible="kb_type != 'prompt' or prompt_approval_state != 'pending'"/>
                    <button name="action_reject_pending_prompt" type="object" string="Rifiuta Modifica Prompt"
                            groups="base.group_system"
                            invisible="kb_type != 'prompt' or prompt_approval_state != 'pending'"/>
                    <button name="action_show_content" type="object" string="Mostra Contenuto" class="oe_highlight" invisible="not is_encrypted"/>
                    <button name="action_log_usage" type="object" string="Registra Utilizzo"/>
                    <field name="prompt_approval_state" widget="statusbar" invisible="kb_type != 'prompt'"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="kb_type != 'prompt' or prompt_approval_state != 'pending'">
                        Modifica proposta da <field name="prompt_pending_author_id" readonly="1"/>
                        il <field name="prompt_pending_since" readonly="1"/>, in attesa di approvazione admin:
                        <field name="prompt_pending_content" readonly="1" widget="text"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Titolo..."/></h1></div>
                    <group>
                        <group string="Classificazione"><field name="kb_type"/><field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"/><field name="brand_id"/><field name="priority"/></group>
                        <group string="Sicurezza"><field name="access_level"/><field name="is_encrypted"/><field name="content_format"/></group>
                    </group>
                    <notebook>
                        <page string="Contenuto"><field name="content" widget="text"/></page>
                        <page string="AI"><field name="use_context"/><field name="embedding"/></page>
                        <page string="Analytics"><group><field name="use_count"/><field name="last_used"/><field name="last_used_by"/></group></page>
                        <page string="Versionamento"><group><field name="version"/><field name="author_id"/><field name="change_notes"/></group>
                            <field name="version_history" readonly="1"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_kb_search" model="ir.ui.view">
        <field name="name">erpv6.kb.search</field><field name="model">erpv6.kb</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="description"/><field name="tag_ids"/><field name="category_id"/>
                <filter string="Fiscale" name="fiscale" domain="[('kb_type','=','fiscale')]"/>
                <filter string="Prompt" name="prompt" domain="[('kb_type','=','prompt')]"/>
                <filter string="Metodo V6" name="metodo" domain="[('kb_type','=','metodo_v6')]"/>
                <!-- TASK 1: filtri per trasversale/verticale -->
                <separator/>
                <filter string="Trasversale" name="trasversale" domain="[('category_id.is_transversal', '=', True)]"/>
                <filter string="Verticale" name="verticale" domain="[('category_id.is_transversal', '=', False)]"/>
                <group expand="0" string="Raggruppa per Verticale">
                    <filter string="Verticale" name="gverticale" context="{'group_by':'category_id:verticale'}"/>
                </group>
                <group expand="0" string="Raggruppa">
                    <filter string="Tipo" name="gtype" context="{'group_by':'kb_type'}"/>
                    <filter string="Categoria" name="gcat" context="{'group_by':'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kb" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field><field name="res_model">erpv6.kb</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="view_kb_search"/>
        <field name="context">{'search_default_gtype': 1}</field>
    </record>
    <record id="view_kb_cat_list" model="ir.ui.view">
        <field name="name">erpv6.kb.category.list</field><field name="model">erpv6.kb.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="kb_type"/><field name="is_transversal" widget="boolean_toggle"/>
                <field name="verticale"/><field name="parent_id"/><field name="sequence"/>
            </list>
        </field>
    </record>
    <record id="view_kb_cat_form" model="ir.ui.view">
        <field name="name">erpv6.kb.category.form</field><field name="model">erpv6.kb.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Nome categoria..."/></h1></div>
                    <group>
                        <group string="Classificazione">
                            <field name="kb_type"/><field name="parent_id"/><field name="sequence"/>
                            <field name="color"/>
                        </group>
                        <group string="Trasversalità/Verticale">
                            <field name="is_transversal" widget="boolean_toggle"/>
                            <field name="verticale" invisible="is_transversal" required="not is_transversal"/>
                        </group>
                    </group>
                    <group string="Descrizione"><field name="description"/></group>
                    <group string="Cache TTL (SaaS child)"><field name="default_ttl_hours"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kb_cat" model="ir.actions.act_window">
        <field name="name">Categorie</field><field name="res_model">erpv6.kb.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_kb_tag" model="ir.actions.act_window">
        <field name="name">Tag</field><field name="res_model">erpv6.kb.tag</field><field name="view_mode">list</field>
    </record>
    <menuitem id="menu_kb" name="Knowledge Base" parent="erpv6_core.menu_erpv6_root" sequence="20"/>
    <menuitem id="menu_kb_articles" name="Articoli" parent="menu_kb" action="action_kb" sequence="10"/>
    <menuitem id="menu_kb_config" name="Configurazione" parent="menu_kb" sequence="90"/>
    <menuitem id="menu_kb_cats" name="Categorie" parent="menu_kb_config" action="action_kb_cat" sequence="10"/>
    <menuitem id="menu_kb_tags" name="Tag" parent="menu_kb_config" action="action_kb_tag" sequence="20"/>
</odoo>
