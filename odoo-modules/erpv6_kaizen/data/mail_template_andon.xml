<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_andon_confirmation" model="mail.template">
            <field name="name">Andon — Conferma ricezione</field>
            <field name="model_id" ref="model_erpv6_kaizen_manual_report"/>
            <field name="subject">✅ Segnalazione #{{ object.id }} ricevuta</field>
            <field name="email_from">noreply@v6impresa.it</field>
            <field name="body_html"><![CDATA[
                <div style="font-family:Arial,sans-serif;color:#0F1E3C;max-width:600px;">
                    <p>Ciao <t t-out="object.reporter_id.name or 'utente'"/>,</p>
                    <p>La tua segnalazione <strong>#<t t-out="object.id"/></strong>
                       è stata ricevuta.</p>
                    <p>
                        <strong>Cosa:</strong> <t t-out="object.name"/><br/>
                        <strong>Gravità:</strong> <t t-out="object.severity or '-'"/><br/>
                        <strong>Pagina di origine:</strong>
                        <t t-out="object.source_url or '-'"/>
                    </p>
                    <p>
                        Il sistema Kaizen la processerà con le 12 regole.
                        Riceverai aggiornamento entro 24h.
                    </p>
                    <p style="color:#999;font-size:11px;margin-top:30px;">
                        V6 Impresa — messaggio automatico
                    </p>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>
