<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_proposal_wizard_form" model="ir.ui.view">
        <field name="name">erpv6.kaizen.product.proposal.wizard.form</field>
        <field name="model">erpv6.kaizen.product.proposal.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="production_order_id" invisible="1"/>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Invia Proposta" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Bottone sulla scheda Produzione (Compito "wizard-prodotto-consulenza",
         25/08/2026): un Consulente puo' proporre un'idea di nuovo prodotto
         dal contesto di una produzione reale su cui sta lavorando - mai un
         prodotto creato direttamente da lui (vedi wizard). -->
    <record id="view_production_order_form_propose_product" model="ir.ui.view">
        <field name="name">erpv6.production.order.form.propose.product</field>
        <field name="model">erpv6.production.order</field>
        <field name="inherit_id" ref="erpv6_production.view_production_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_propose_new_product" type="object" string="Proponi Nuovo Prodotto"/>
            </xpath>
        </field>
    </record>
</odoo>
