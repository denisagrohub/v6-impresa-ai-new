<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 02/10/2026 (C1b-DISC): cron settimanale domenica 03:00 UTC.
             Genera/aggiorna profilo DISC per controparti B2B attive.
             Guardrail G7: esclude persone fisiche senza legame
             business e utenti interni V6. -->
        <record id="cron_disc_profile_refresh" model="ir.cron">
            <field name="name">DISC: refresh profilo controparti B2B</field>
            <field name="model_id" ref="model_erpv6_partner_disc_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_counterparts()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=3, minute=0, second=0, microsecond=0) + timedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
