<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 05/10/2026 (C-attribution-1b): default da cui il wizard
             propone lo split. Modificabili da Settings.
             V6 riserva 10% e' il pool per co-segnalatori; crescera'
             in futuro, il campo e' editabile.
             Esempio reale (confermato master):
               Christian 30 (portatore)
               Denis 30 (operativo)
               Enzo 30 (operativo, porta anche il compratore - nota)
               V6 10 (riserva) -->
        <record id="param_split_default_portatore" model="ir.config_parameter">
            <field name="key">credit.split.default_portatore</field>
            <field name="value">30</field>
        </record>

        <record id="param_split_default_v6" model="ir.config_parameter">
            <field name="key">credit.split.default_v6</field>
            <field name="value">10</field>
        </record>

        <record id="param_split_default_operativo" model="ir.config_parameter">
            <field name="key">credit.split.default_operativo</field>
            <field name="value">60</field>
        </record>

        <record id="param_split_default_co_segnalatore" model="ir.config_parameter">
            <field name="key">credit.split.default_co_segnalatore</field>
            <field name="value">3</field>
        </record>

    </data>
</odoo>
