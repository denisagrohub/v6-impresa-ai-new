<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Scraping bandi ogni 6 ore -->
        <record id="cron_scrape_bandi" model="ir.cron">
            <field name="name">Scrape Bandi - Ogni 6 ore</field>
            <field name="model_id" ref="model_erpv6_bando_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_scrape_all()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Check scadenze ogni giorno -->
        <record id="cron_check_scadenze" model="ir.cron">
            <field name="name">Check Scadenze Bandi - Giornaliero</field>
            <field name="model_id" ref="model_erpv6_bando"/>
            <field name="state">code</field>
            <field name="code">
                import datetime
                today = fields.Date.today()
                bandi = model.search([('scadenza_domanda', '&lt;', today), ('status', '=', 'active')])
                for bando in bandi:
                    bando.action_expire()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Match automatico ogni 12 ore -->
        <record id="cron_match_automatico" model="ir.cron">
            <field name="name">Match Automatico Bandi - Ogni 12 ore</field>
            <field name="model_id" ref="model_erpv6_bando"/>
            <field name="state">code</field>
            <field name="code">
                # Logica di match automatico da implementare
                _logger.info("Cron match automatico eseguito")
            </field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
