<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template email per notifica match -->
        <record id="mail_template_bando_match" model="mail.template">
            <field name="name">Notifica Match Bando</field>
            <field name="model_id" ref="model_erpv6_bando_match"/>
            <field name="subject">Nuovo bando compatibile: {{ object.bando_id.name }}</field>
            <field name="email_to">{{ object.consultant_id.email or '' }}</field>
            <field name="body_html" type="html">
                <![CDATA[
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2>Nuova opportunità di finanziamento rilevata</h2>
                    <p>Gentile {{ object.consultant_id.name or 'Consulente' }},</p>
                    <p>È stato rilevato un nuovo bando compatibile con il cliente <strong>{{ object.partner_id.name }}</strong>:</p>
                    
                    <table style="border: 1px solid #ddd; padding: 15px; margin: 20px 0;">
                        <tr><td><strong>Bando:</strong></td><td>{{ object.bando_id.name }}</td></tr>
                        <tr><td><strong>Ente:</strong></td><td>{{ object.bando_id.ente }}</td></tr>
                        <tr><td><strong>Importo Max:</strong></td><td>{{ object.importo_stimato }} €</td></tr>
                        <tr><td><strong>Compatibilità:</strong></td><td>{{ object.eligibility_score }}%</td></tr>
                        <tr><td><strong>Scadenza:</strong></td><td>{{ object.bando_id.scadenza_domanda or 'Non specificata' }}</td></tr>
                    </table>
                    
                    <p>Motivi compatibilità:</p>
                    <p style="background: #f5f5f5; padding: 10px;">{{ object.motivi_compatibilita or 'Nessun motivo specificato' }}</p>
                    
                    <p style="margin-top: 30px;">
                        <a href="/web#model=erpv6.bando.match&amp;id={{ object.id }}" 
                           style="background: #7c7bad; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
                            Visualizza dettagli
                        </a>
                    </p>
                </div>
                ]]>
            </field>
        </record>

        <!-- Template email per scadenza imminente -->
        <record id="mail_template_scadenza_bando" model="mail.template">
            <field name="name">Alert Scadenza Bando</field>
            <field name="model_id" ref="model_erpv6_bando_application"/>
            <field name="subject">⚠️ Scadenza imminente: {{ object.bando_id.name }}</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="body_html" type="html">
                <![CDATA[
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2 style="color: #f97316;">⚠️ Scadenza Imminente</h2>
                    <p>Gentile Cliente,</p>
                    <p>La candidatura per il bando <strong>{{ object.bando_id.name }}</strong> scade tra meno di 7 giorni.</p>
                    
                    <table style="border: 1px solid #ddd; padding: 15px; margin: 20px 0;">
                        <tr><td><strong>Scadenza:</strong></td><td>{{ object.bando_id.scadenza_domanda }}</td></tr>
                        <tr><td><strong>Stato:</strong></td><td>{{ dict(object._fields['status'].selection).get(object.status) }}</td></tr>
                    </table>
                    
                    <p>Contatta il tuo consulente per completare la procedura.</p>
                </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
