<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configurazione Agenti: registro condiviso, un record per agente
         (Kaizen registrato da erpv6_kaizen via data XML, futuri agenti
         allo stesso modo). -->
    <record id="view_agent_config_form" model="ir.ui.view">
        <field name="name">erpv6.agent.config.form</field>
        <field name="model">erpv6.agent.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione Agente">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Nome agente..."/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="pattern_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="instructions_category_id"/>
                            <field name="context_category_id"/>
                            <field name="omni_task_type"/>
                        </group>
                    </group>
                    <group string="Identità">
                        <field name="persona_kb_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group string="Escalation">
                        <field name="escalation_minutes"/>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_agent_config_list" model="ir.ui.view">
        <field name="name">erpv6.agent.config.list</field>
        <field name="model">erpv6.agent.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="instructions_category_id"/>
                <field name="omni_task_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_agent_config" model="ir.actions.act_window">
        <field name="name">Configurazione Agenti</field>
        <field name="res_model">erpv6.agent.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Thor: crea un nuovo agente scegliendo un pattern gia' pronto,
         nessun codice Python da scrivere: vedi agent_create_wizard.py. -->
    <record id="view_agent_create_wizard_form" model="ir.ui.view">
        <field name="name">erpv6.agent.create_wizard.form</field>
        <field name="model">erpv6.agent.create_wizard</field>
        <field name="arch" type="xml">
            <form string="Thor - Crea Nuovo Agente">
                <group>
                    <field name="name" placeholder="Nome agente, es. Sabrina..."/>
                    <field name="code" placeholder="codice tecnico, es. sabrina"/>
                    <field name="pattern_id"/>
                </group>
                <group string="Istruzioni e contesto (scegli esistente o scrivi un nome nuovo per crearla)">
                    <field name="instructions_category_id"/>
                    <field name="context_category_id"/>
                </group>
                <group string="Rotta AI">
                    <field name="omni_task_type"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crea Agente" class="oe_highlight"/>
                    <button string="Annulla" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_agent_create_wizard" model="ir.actions.act_window">
        <field name="name">Thor - Nuovo Agente</field>
        <field name="res_model">erpv6.agent.create_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Proposte: gate umano condiviso da tutti gli agenti. -->
    <record id="view_agent_proposal_form" model="ir.ui.view">
        <field name="name">erpv6.agent.proposal.form</field>
        <field name="model">erpv6.agent.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposta Agente">
                <header>
                    <button name="action_accept" type="object" string="Accetta" class="oe_highlight"
                            invisible="status != 'pending_review'"/>
                    <button name="action_reject" type="object" string="Rifiuta"
                            invisible="status != 'pending_review'"/>
                    <button name="action_mark_actioned" type="object" string="Segna come Attuata"
                            invisible="status != 'accepted'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending_review,accepted,actioned"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agent_config_id" readonly="1"/>
                            <field name="rule_applied" readonly="1"/>
                            <field name="provider_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Proposta">
                        <field name="proposal_text" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Basata su">
                        <field name="based_on" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Note del revisore">
                        <field name="review_notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_agent_proposal_list" model="ir.ui.view">
        <field name="name">erpv6.agent.proposal.list</field>
        <field name="model">erpv6.agent.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="agent_config_id"/>
                <field name="name"/>
                <field name="rule_applied"/>
                <field name="status" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="action_agent_proposal" model="ir.actions.act_window">
        <field name="name">Proposte Agenti</field>
        <field name="res_model">erpv6.agent.proposal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_agent_proposal_accept_wizard_form" model="ir.ui.view">
        <field name="name">erpv6.agent.proposal.accept_wizard.form</field>
        <field name="model">erpv6.agent.proposal.accept_wizard</field>
        <field name="arch" type="xml">
            <form string="Assegna ed accetta">
                <group>
                    <field name="proposal_text" nolabel="1" readonly="1"/>
                </group>
                <group>
                    <field name="assignee_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Conferma" class="oe_highlight"/>
                    <button string="Annulla" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Telegram: PLACEHOLDER (Compito 3, 22/08/2026) — vedi
         agent_telegram_config.py, nessun canale reale attivo oggi. -->
    <record id="view_agent_telegram_config_form" model="ir.ui.view">
        <field name="name">erpv6.agent.telegram.config.form</field>
        <field name="model">erpv6.agent.telegram.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione Telegram (placeholder)">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Nessun canale Telegram reale è attivo. Questa scheda è solo un placeholder
                        pronto a essere completato quando arriverà un vero Bot Token.
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Nome configurazione..."/></h1></div>
                    <group>
                        <group>
                            <field name="agent_config_id"/>
                            <field name="is_active" readonly="1"/>
                        </group>
                        <group>
                            <field name="bot_token" password="True" placeholder="(non ancora fornito)"/>
                            <field name="chat_id"/>
                        </group>
                    </group>
                    <group string="Nota">
                        <field name="note_placeholder" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_agent_telegram_config_list" model="ir.ui.view">
        <field name="name">erpv6.agent.telegram.config.list</field>
        <field name="model">erpv6.agent.telegram.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_config_id"/>
                <field name="chat_id"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_agent_telegram_config" model="ir.actions.act_window">
        <field name="name">Telegram (placeholder)</field>
        <field name="res_model">erpv6.agent.telegram.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Comunicazioni strutturate (Compito 4, 23/08/2026): schema standard
         obbligatorio, piu' routing Heinrich (Compito 3), vedi
         agent_communication.py. Sola lettura in vista (i campi si
         valorizzano da codice, mai a mano da form): serve per ispezionare
         cosa e' stato instradato/bloccato, non per crearne di nuove qui. -->
    <record id="view_agent_communication_list" model="ir.ui.view">
        <field name="name">erpv6.agent.communication.list</field>
        <field name="model">erpv6.agent.communication</field>
        <field name="arch" type="xml">
            <list>
                <field name="occurred_at"/>
                <field name="agent_config_id"/>
                <field name="heinrich_severity" widget="badge"/>
                <field name="routing_state" widget="badge"/>
                <field name="assignee_user_id"/>
                <field name="assignee_agent_id"/>
                <field name="reviewer_user_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_agent_communication_form" model="ir.ui.view">
        <field name="name">erpv6.agent.communication.form</field>
        <field name="model">erpv6.agent.communication</field>
        <field name="arch" type="xml">
            <form string="Comunicazione Agente">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="agent_config_id"/>
                            <field name="occurred_at"/>
                            <field name="heinrich_severity" widget="badge"/>
                            <field name="routing_state" widget="badge"/>
                        </group>
                        <group>
                            <field name="assignee_user_id"/>
                            <field name="assignee_agent_id"/>
                            <field name="reviewer_user_id"/>
                            <field name="confirmation_id"/>
                        </group>
                    </group>
                    <group string="Cosa stava facendo / problema">
                        <field name="action_in_progress" nolabel="1"/>
                        <field name="problem_description" nolabel="1"/>
                    </group>
                    <group string="Valutazione">
                        <field name="pareto_analysis_id"/>
                        <field name="kairos_matrix_id"/>
                        <field name="heinrich_indicator_id"/>
                        <field name="evaluation_notes" nolabel="1"/>
                    </group>
                    <group string="Esito / rischio / miglioria">
                        <field name="outcome_if_resolved" nolabel="1"/>
                        <field name="risk_if_nothing_done" nolabel="1"/>
                        <field name="proposed_improvement" nolabel="1"/>
                    </group>
                    <group string="Instradamento" invisible="routing_state != 'incomplete'">
                        <field name="missing_fields_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_agent_communication" model="ir.actions.act_window">
        <field name="name">Comunicazioni Strutturate</field>
        <field name="res_model">erpv6.agent.communication</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Motore di monitoraggio attivo (Compito 1, 23/08/2026): elenco
         regole per dominio, condivise da tutti gli agenti. -->
    <record id="view_agent_monitor_rule_list" model="ir.ui.view">
        <field name="name">erpv6.agent.monitor.rule.list</field>
        <field name="model">erpv6.agent.monitor.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="agent_config_id"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="heinrich_severity" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_agent_monitor_rule_form" model="ir.ui.view">
        <field name="name">erpv6.agent.monitor.rule.form</field>
        <field name="model">erpv6.agent.monitor.rule</field>
        <field name="arch" type="xml">
            <form string="Regola di Monitoraggio">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="agent_config_id"/>
                            <field name="res_model"/>
                            <field name="domain"/>
                            <field name="signal_key"/>
                        </group>
                        <group>
                            <field name="heinrich_severity"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Testi (usati nella comunicazione strutturata generata)">
                        <field name="outcome_hint"/>
                        <field name="risk_hint"/>
                        <field name="improvement_hint"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_agent_monitor_rule" model="ir.actions.act_window">
        <field name="name">Motore di Monitoraggio (regole)</field>
        <field name="res_model">erpv6.agent.monitor.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_agent_root" name="Agenti AI" parent="erpv6_core.menu_erpv6_root" sequence="16"/>
    <menuitem id="menu_agent_communication" name="Comunicazioni Strutturate" parent="menu_agent_root"
              action="action_agent_communication" sequence="15"/>
    <menuitem id="menu_agent_monitor_rule" name="Motore di Monitoraggio" parent="menu_agent_root"
              action="action_agent_monitor_rule" sequence="17" groups="base.group_system"/>
    <menuitem id="menu_agent_proposal" name="Proposte" parent="menu_agent_root"
              action="action_agent_proposal" sequence="10"/>
    <menuitem id="menu_agent_config" name="Configurazione Agenti" parent="menu_agent_root"
              action="action_agent_config" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_agent_create_wizard" name="Nuovo Agente (Thor)" parent="menu_agent_root"
              action="action_agent_create_wizard" sequence="80" groups="base.group_system"/>
    <menuitem id="menu_agent_telegram_config" name="Telegram (placeholder)" parent="menu_agent_root"
              action="action_agent_telegram_config" sequence="95" groups="base.group_system"/>
</odoo>
