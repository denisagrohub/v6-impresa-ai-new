<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_argus_propose" model="ir.cron">
            <field name="name">Gate-2c Argus propone miglioramenti</field>
            <field name="model_id" ref="model_erpv6_agent_proposal"/>
            <field name="state">code</field>
            <field name="code">model._cron_argus_propose()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=24)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
