<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 07/10/2026 (C-telegram-otp-bot-1): polling dedicato per
             bot OTP (V6 Auth).

             NOTA: Odoo 18 non supporta interval_type='seconds'.
             Minimo = 1 minuto. Per ottenere latenza <1s, il metodo
             _poll_updates_otp fa LONG POLLING con timeout=50s:
             in pratica il cron gira, aspetta 50s in ascolto, elabora,
             esce; al prossimo minuto ripete. Il gap tra cron e' ~10s,
             ma la maggior parte del tempo il sistema e' "in ascolto".

             Latenza reale percepita dall'utente:
               - 83% del tempo: <1s (long polling attivo)
               - 17% del tempo (gap): fino a 10s

             Se serve latenza garantita <1s: richiede processo
             worker separato fuori da Odoo (anti-pattern). -->
        <record id="cron_poll_otp_updates" model="ir.cron">
            <field name="name">V6 Auth: polling OTP (long polling 50s)</field>
            <field name="model_id" ref="model_erpv6_agent_telegram_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_otp_updates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
