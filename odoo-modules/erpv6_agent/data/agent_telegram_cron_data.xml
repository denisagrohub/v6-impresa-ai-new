<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Compito 6 (23/08/2026): cron di polling Telegram, condiviso
             (stesso principio di cron_check_agent_direct_messages), gira
             sempre, ma oggi e' sempre una query vuota senza nessuna
             chiamata HTTP (nessuna erpv6.agent.telegram.config ha
             is_active=True: quel campo resta False finche' Denis non
             fornisce un vero Bot Token, vedi agent_telegram_config.py).
             Intervallo breve (2 minuti) perche', una volta attivato, e'
             l'UNICO modo con cui questo canale scopre messaggi umani nuovi
             (polling, non webhook, vedi motivazione nel modello). -->
        <record id="cron_poll_telegram_updates" model="ir.cron">
            <field name="name">Agenti: Polling Telegram (predisposto, inattivo senza token reale) - Ogni 2 minuti</field>
            <field name="model_id" ref="model_erpv6_agent_telegram_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_telegram_updates()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
    </data>
</odoo>
