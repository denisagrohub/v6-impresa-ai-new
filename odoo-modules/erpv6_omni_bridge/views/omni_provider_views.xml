<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Provider Form View -->
    <record id="view_omni_provider_form" model="ir.ui.view">
        <field name="name">erpv6.omni.provider.form</field>
        <field name="model">erpv6.omni.provider</field>
        <field name="arch" type="xml">
            <form string="Provider AI">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connessione" 
                            class="btn-primary" icon="fa-plug"/>
                    <field name="is_active" widget="boolean_toggle" statusbar="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_omni_call_log)d" type="action" 
                                class="oe_stat_button" icon="fa-list">
                            <field name="total_calls" widget="statinfo" string="Chiamate"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome Provider"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="provider_type"/>
                            <field name="priority"/>
                            <field name="supported_models" placeholder="gpt-4, claude-3, llama-2"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                            <field name="api_url"/>
                            <field name="api_version"/>
                            <field name="timeout_seconds"/>
                            <field name="max_rpm"/>
                        </group>
                    </group>
                    <group string="Costi">
                        <field name="cost_per_1k_input"/>
                        <field name="cost_per_1k_output"/>
                        <field name="total_cost"/>
                    </group>
                    <group string="Statistiche">
                        <field name="success_rate" widget="progressbar"/>
                        <field name="last_error_at"/>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Provider Tree View -->
    <record id="view_omni_provider_tree" model="ir.ui.view">
        <field name="name">erpv6.omni.provider.tree</field>
        <field name="model">erpv6.omni.provider</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type"/>
                <field name="priority"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="success_rate" widget="progressbar"/>
                <field name="total_cost" sum="Totale"/>
                <field name="total_calls" sum="Totale"/>
            </tree>
        </field>
    </record>

    <!-- Provider Search View -->
    <record id="view_omni_provider_search" model="ir.ui.view">
        <field name="name">erpv6.omni.provider.search</field>
        <field name="model">erpv6.omni.provider</field>
        <field name="arch" type="xml">
            <search string="Cerca Provider">
                <field name="name"/>
                <field name="code"/>
                <filter string="Attivi" name="active" domain="[('is_active','=',True)]"/>
                <filter string="LLM" name="llm" domain="[('provider_type','=','llm')]"/>
                <filter string="Trascrizione" name="transcription" domain="[('provider_type','=','transcription')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Tipo" name="group_type" context="{'group_by':'provider_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_omni_provider" model="ir.actions.act_window">
        <field name="name">Provider AI</field>
        <field name="res_model">erpv6.omni.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_omni_provider_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura il tuo primo provider AI
            </p>
            <p>
                Aggiungi provider come OpenAI, Anthropic, Groq, Deepgram per abilitare le funzionalità AI.
            </p>
        </field>
    </record>
</odoo>
