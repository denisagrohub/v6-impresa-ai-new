        <!-- label_output -->
        <record id="input_spec_label_output_output_id" model="erpv6.core.process.input_spec">
            <field name="process_key">label_output</field>
            <field name="input_key">output_id</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
            <field name="note">erpv6.core.output gia' dichiarato</field>
        </record>
        <record id="output_spec_label_output" model="erpv6.core.process.output_spec">
            <field name="process_key">label_output</field>
            <field name="output_tipo_dato">json</field>
        </record>

        <!-- heinrich_log_signal -->
        <record id="input_spec_heinrich_log_signal_res_model" model="erpv6.core.process.input_spec">
            <field name="process_key">heinrich_log_signal</field>
            <field name="input_key">res_model</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
        </record>
        <record id="input_spec_heinrich_log_signal_res_id" model="erpv6.core.process.input_spec">
            <field name="process_key">heinrich_log_signal</field>
            <field name="input_key">res_id</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
