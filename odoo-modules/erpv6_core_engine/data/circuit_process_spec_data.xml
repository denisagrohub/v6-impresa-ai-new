        </record>
        <record id="input_spec_heinrich_log_signal_description" model="erpv6.core.process.input_spec">
            <field name="process_key">heinrich_log_signal</field>
            <field name="input_key">description</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="False"/>
        </record>
        <record id="output_spec_heinrich_log_signal" model="erpv6.core.process.output_spec">
