        <record id="input_spec_pareto_log_item_impatto" model="erpv6.core.process.input_spec">
            <field name="process_key">pareto_log_item</field>
            <field name="input_key">impatto</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
            <field name="note">intero 1-5</field>
        </record>
        <record id="output_spec_pareto_log_item" model="erpv6.core.process.output_spec">
            <field name="process_key">pareto_log_item</field>
            <field name="output_tipo_dato">json</field>
        </record>

        <!-- crea_lead -->
        <record id="input_spec_crea_lead_name" model="erpv6.core.process.input_spec">
