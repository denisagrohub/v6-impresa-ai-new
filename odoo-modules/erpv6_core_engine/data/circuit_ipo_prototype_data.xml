<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Prototipo IPO intelligente (Denis, 29/08/2026): circuito
             PARALLELO ai 6 Giudici, non li tocca. Prova ridotta: 2 analisti
             + un arbitro, tutti Motori IPO veri (process_key=ai_analyze,
             chiamano davvero erpv6_omni_bridge). Se questo funziona, il
             meccanismo IPO generalizza anche ai processi intelligenti, non
             solo a quelli deterministici come Typst. Allora si valuta la
             migrazione vera dei 6 Giudici su questo stesso schema. -->
        <record id="circuit_ipo_prototype" model="erpv6.core.node">
            <field name="name">Prototipo IPO — 2 Giudici</field>
            <field name="parent_id" ref="circuit_workspace_root"/>
            <field name="is_composite" eval="True"/>
            <field name="circuit_role">generico</field>
        </record>

        <record id="node_ipo_analista_1" model="erpv6.core.node">
            <field name="name">Analista IPO 1</field>
            <field name="parent_id" ref="circuit_ipo_prototype"/>
            <field name="sequence">10</field>
            <field name="process_key">ai_analyze</field>
            <field name="input_format">prompt</field>
        </record>
        <record id="node_ipo_analista_2" model="erpv6.core.node">
            <field name="name">Analista IPO 2</field>
            <field name="parent_id" ref="circuit_ipo_prototype"/>
            <field name="sequence">20</field>
            <field name="process_key">ai_analyze</field>
            <field name="input_format">prompt</field>
        </record>
        <record id="node_ipo_arbitro" model="erpv6.core.node">
            <field name="name">Arbitro IPO</field>
            <field name="parent_id" ref="circuit_ipo_prototype"/>
            <field name="sequence">30</field>
            <field name="is_composite" eval="True"/>
            <field name="circuit_role">generico</field>
            <field name="phase_gate_type">ai</field>
            <field name="process_key">ai_analyze</field>
            <field name="input_format">prompt</field>
        </record>

        <record id="arc_ipo_analista1_to_arbitro" model="erpv6.core.arc">
            <field name="source_node_id" ref="node_ipo_analista_1"/>
            <field name="target_node_id" ref="node_ipo_arbitro"/>
            <field name="action_type">data_flow</field>
            <field name="is_and_join" eval="True"/>
        </record>
        <record id="arc_ipo_analista2_to_arbitro" model="erpv6.core.arc">
            <field name="source_node_id" ref="node_ipo_analista_2"/>
            <field name="target_node_id" ref="node_ipo_arbitro"/>
            <field name="action_type">data_flow</field>
            <field name="is_and_join" eval="True"/>
        </record>

        <!-- Rombi KB: riusano DAVVERO 2 dei 6 prompt gia' esistenti dei
             Giudici veri (Analista 1, Analista 2), stesso materiale
             reale, non inventato per il prototipo. -->
        <record id="kb_link_ipo_analista_1" model="erpv6.core.kb_link">
            <field name="target_node_id" ref="node_ipo_analista_1"/>
            <field name="resolution_mode">fixed_kb</field>
            <field name="kb_id" ref="erpv6_production.kb_prompt_validation_analyst_1"/>
            <field name="data_format">prompt</field>
        </record>
        <record id="kb_link_ipo_analista_2" model="erpv6.core.kb_link">
            <field name="target_node_id" ref="node_ipo_analista_2"/>
            <field name="resolution_mode">fixed_kb</field>
            <field name="kb_id" ref="erpv6_production.kb_prompt_validation_analyst_2"/>
            <field name="data_format">prompt</field>
        </record>
        <record id="kb_link_ipo_arbitro" model="erpv6.core.kb_link">
            <field name="target_node_id" ref="node_ipo_arbitro"/>
            <field name="resolution_mode">fixed_kb</field>
            <field name="kb_id" ref="erpv6_production.kb_prompt_validation_sesto_uomo"/>
            <field name="data_format">prompt</field>
        </record>

        <!-- Fase (Denis, 29/08/2026: "il gate non e' sui nodi, ma sulla
             fase"): prima il prototipo non aveva nessuna Fase, il Gate
             stava (erroneamente) sul nodo. Arbitro IPO e' il gate di
             uscita: unico nodo con phase_gate_type in questa Fase. -->
        <record id="phase_ipo_prototype" model="erpv6.core.phase">
            <field name="name">Prototipo IPO — 2 Giudici</field>
            <field name="exit_gate_ids" eval="[(6, 0, [ref('node_ipo_arbitro')])]"/>
            <field name="node_ids" eval="[(6, 0, [
                ref('node_ipo_analista_1'), ref('node_ipo_analista_2'), ref('node_ipo_arbitro')])]"/>
        </record>

    </data>
</odoo>
