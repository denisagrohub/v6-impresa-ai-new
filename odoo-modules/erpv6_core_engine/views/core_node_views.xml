<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erpv6_core_node_tree" model="ir.ui.view">
        <field name="name">erpv6.core.node.list</field>
        <field name="model">erpv6.core.node</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_composite"/>
                <field name="circuit_role"/>
                <field name="analyst_index"/>
                <field name="parent_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_erpv6_core_node_form" model="ir.ui.view">
        <field name="name">erpv6.core.node.form</field>
        <field name="model">erpv6.core.node</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="is_composite"/>
                        <field name="circuit_role" invisible="not is_composite"/>
                        <field name="analyst_index"/>
                        <field name="input_format"/>
                        <field name="active"/>
                    </group>
                    <group string="Motore reale collegato">
                        <field name="engine_model"/>
                        <field name="engine_method"/>
                    </group>
                    <notebook>
                        <page string="Nodi/Circuiti contenuti">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="analyst_index"/>
                                    <field name="circuit_role"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Archi in ingresso">
                            <field name="input_arc_ids">
                                <list editable="bottom">
                                    <field name="source_node_id"/>
                                    <field name="action_type"/>
                                    <field name="is_and_join"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Archi in uscita">
                            <field name="output_arc_ids">
                                <list editable="bottom">
                                    <field name="target_node_id"/>
                                    <field name="action_type"/>
                                    <field name="is_and_join"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rombi KB collegati">
                            <field name="kb_link_ids">
                                <list editable="bottom">
                                    <field name="resolution_mode"/>
                                    <field name="kb_id"/>
                                    <field name="data_format"/>
                                    <field name="format_mismatch"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_erpv6_core_node" model="ir.actions.act_window">
        <field name="name">Nodi / Circuiti (Adaptive EOSv6)</field>
        <field name="res_model">erpv6.core.node</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'default_is_composite': True}</field>
    </record>

    <menuitem id="menu_erpv6_core_engine_root" name="Core Engine" parent="erpv6_core.menu_erpv6_root" sequence="50"/>
    <menuitem id="menu_erpv6_core_node" name="Nodi / Circuiti" parent="menu_erpv6_core_engine_root"
              action="action_erpv6_core_node" sequence="10"/>
</odoo>
