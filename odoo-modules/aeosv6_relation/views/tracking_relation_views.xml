<odoo>
    <record id="view_tracking_relation_tree" model="ir.ui.view">
        <field name="name">erpv6.tracking.relation.tree</field>
        <field name="model">erpv6.tracking.relation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="email_alias"/>
                <field name="ruolo"/>
                <field name="posta_in_gioco"/>
                <field name="mandato"/>
                <field name="richiede_nda"/>
                <field name="nda_gate_ok"/>
            </list>
        </field>
    </record>

    <record id="view_tracking_relation_form" model="ir.ui.view">
        <field name="name">erpv6.tracking.relation.form</field>
        <field name="model">erpv6.tracking.relation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="partner_id"/>
                        <field name="email_alias"/>
                    </group>
                    <group>
                        <field name="ruolo"/>
                        <field name="posta_in_gioco"/>
                        <field name="mandato"/>
                    </group>
                    <group>
                        <field name="richiede_nda"/>
                        <field name="nda_gate_ok" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Nodi Figlio">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="ruolo"/>
                                    <field name="nda_gate_ok"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contratti">
                            <field name="contract_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_tracking_relation" model="ir.actions.act_window">
        <field name="name">Relazioni di Tracciamento</field>
        <field name="res_model">erpv6.tracking.relation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tracking_relation_root" name="Tracking Relation" sequence="90"
              web_icon="aeosv6_relation,static/description/icon.png"/>
    <menuitem id="menu_tracking_relation" name="Relazioni" parent="menu_tracking_relation_root"
              action="action_tracking_relation" sequence="10"/>
</odoo>
