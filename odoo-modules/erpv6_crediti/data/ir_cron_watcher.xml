<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 05/10/2026 (C-crediti-1c-fix): noupdate=1 + active=True.
         Il flag active era resettato a False da ogni upgrade modulo
         (record ricaricato). Ora lo stato di produzione e' persistente. -->
    <data noupdate="1">

        <record id="cron_watcher_credit_emails" model="ir.cron">
            <field name="name">Crediti: Watcher email cassetti</field>
            <field name="model_id" ref="model_erpv6_credit_portfolio"/>
            <field name="state">code</field>
            <field name="code">model._cron_watcher_credit_emails()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
