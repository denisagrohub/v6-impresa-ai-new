<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aggiunge il secondo gate (supervisore KB) alla vista generica di
         erpv6_validation, senza toccarla direttamente: il motore generico
         non deve sapere nulla del concetto "supervisore KB" (vedi
         validation_session.py/action_supervisor_approve). -->
    <record id="view_erpv6_validation_session_form_kb_supervisor" model="ir.ui.view">
        <field name="name">erpv6.validation.session.form.kb.supervisor</field>
        <field name="model">erpv6.validation.session</field>
        <field name="inherit_id" ref="erpv6_validation.view_erpv6_validation_session_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="after">
                <!-- Contenuto leggibile della voce KB, in chiaro: context_data
                     (sotto, generico) resta un editor JSON grezzo, poco
                     leggibile per giudicare una voce durante la revisione
                     umana (segnalato dal vivo dall'utente). -->
                <group invisible="res_model != 'erpv6.kb'" string="Voce KB da Validare">
                    <field name="kb_id" readonly="1"/>
                    <field name="kb_category_display"/>
                    <field name="kb_content_display" nolabel="1" colspan="2"/>
                </group>
            </div>
            <!-- Per le sessioni voce KB, i due gate separati (Approva +
                 Approvazione Supervisore) restano nel codice (audit/storico,
                 vedi action_validate_kb) ma spariscono dalla UI a favore di
                 un solo bottone "Valida": segnalato dal vivo dall'utente
                 il 20/08/2026: il flusso a due click separati portava a
                 compilare a mano i campi di revisione pensando fosse quello
                 il modo di validare (vedi commento su action_validate_kb). -->
            <button name="action_human_approve" position="attributes">
                <attribute name="invisible">status not in ('converged', 'escalated_to_human') or res_model == 'erpv6.kb'</attribute>
            </button>
            <button name="action_human_approve" position="after">
                <button name="action_validate_kb" type="object" string="Valida"
                        class="oe_highlight"
                        invisible="status not in ('converged', 'escalated_to_human', 'human_reviewed') or res_model != 'erpv6.kb'"/>
                <button name="action_supervisor_approve" type="object"
                        string="Approvazione Supervisore KB (finale)"
                        invisible="1"/>
            </button>
            <field name="status" position="attributes">
                <attribute name="statusbar_visible">draft,in_validation,converged,human_reviewed,approved</attribute>
            </field>
            <field name="human_notes" position="after">
                <field name="kb_supervisor_id" readonly="1" invisible="res_model != 'erpv6.kb'"/>
                <field name="kb_supervisor_approved_at" readonly="1" invisible="res_model != 'erpv6.kb'"/>
            </field>
        </field>
    </record>

    <!-- Filtro per isolare le sessioni gia' passate dal primo gate, prima di
         selezionarle in blocco per il secondo gate (supervisore KB): vedi
         data/validation_session_bulk_actions.xml. -->
    <record id="view_erpv6_validation_session_search_kb_reviewed" model="ir.ui.view">
        <field name="name">erpv6.validation.session.search.kb.reviewed</field>
        <field name="model">erpv6.validation.session</field>
        <field name="inherit_id" ref="erpv6_validation.view_erpv6_validation_session_search"/>
        <field name="arch" type="xml">
            <filter name="approved" position="before">
                <filter string="Revisionato (primo gate, in attesa supervisore)" name="human_reviewed"
                        domain="[('status', '=', 'human_reviewed')]"/>
            </filter>
        </field>
    </record>
</odoo>
