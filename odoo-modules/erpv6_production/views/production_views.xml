<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PRODUCTION ORDER -->
    <record id="view_production_order_list" model="ir.ui.view">
        <field name="name">erpv6.production.order.list</field>
        <field name="model">erpv6.production.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="lead_id"/><field name="phase_id"/>
                <field name="interview_package_hint"/><field name="interview_score"/>
            </list>
        </field>
    </record>
    <record id="view_production_order_form" model="ir.ui.view">
        <field name="name">erpv6.production.order.form</field>
        <field name="model">erpv6.production.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_consultant_advance" type="object" string="Valuta avanzamento" class="oe_highlight"/>
                    <button name="action_create_contract" type="object" string="Crea Contratto"
                            invisible="contract_id"/>
                    <button name="action_genera_analisi_win_win" type="object" string="Genera Analisi Win-Win"/>
                    <button name="action_determina_profilo_disc" type="object" string="Genera Profilo DISC"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Collegamento">
                            <field name="lead_id"/>
                            <field name="package_id"/>
                            <field name="prodotto_id"/>
                            <field name="phase_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                        </group>
                        <group string="Dati Intervista">
                            <field name="interview_package_hint"/>
                            <field name="interview_score"/>
                            <field name="verticale"/>
                            <field name="interview_tipo_progetto"/>
                            <field name="interview_destinatario"/>
                            <field name="interview_budget"/>
                            <field name="interview_tempistiche"/>
                            <field name="interview_fatturato"/>
                        </group>
                        <group string="Metodo">
                            <field name="metodo_ultima_analisi_date" readonly="1"/>
                            <field name="metodo_ultimo_suggerimento" readonly="1"/>
                            <field name="winwin_ultima_analisi_date" readonly="1"/>
                            <field name="disc_ultima_analisi_date" readonly="1"/>
                            <field name="disc_profilo_dominante" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eventi">
                            <field name="event_ids">
                                <list>
                                    <field name="create_date"/><field name="event_type"/>
                                    <field name="phase_before_id"/><field name="phase_after_id"/>
                                    <field name="decision_method"/><field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documenti Prodotti">
                            <field name="document_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/><field name="category"/><field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pianificazione Risorse">
                            <field name="schedule_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="phase_id"/><field name="resource_id"/>
                                    <field name="planned_hours"/><field name="date_start"/><field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tranche Pagamento" invisible="not prodotto_id">
                            <field name="tranche_ids" create="0" delete="0">
                                <list>
                                    <field name="tranche_number"/>
                                    <field name="fase_config_id"/>
                                    <field name="importo"/>
                                    <field name="stato"/>
                                    <field name="data_incasso"/>
                                    <field name="confirmed_by"/>
                                    <button name="action_marca_incassata" type="object"
                                            string="Marca Incassata" class="oe_highlight"
                                            invisible="stato == 'incassata'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_production_order" model="ir.actions.act_window">
        <field name="name">Produzioni</field>
        <field name="res_model">erpv6.production.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- PRODUCTION PHASE (catalogo) -->
    <record id="view_production_phase_list" model="ir.ui.view">
        <field name="name">erpv6.production.phase.list</field>
        <field name="model">erpv6.production.phase</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/><field name="phase_kind"/>
                <field name="requires_output"/><field name="output_category"/>
                <field name="typst_template_id"/>
                <field name="requires_validation"/><field name="validation_mode"/>
                <field name="estimated_hours"/>
                <field name="eligible_resource_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="action_production_phase" model="ir.actions.act_window">
        <field name="name">Fasi di Produzione (catalogo)</field>
        <field name="res_model">erpv6.production.phase</field>
        <field name="view_mode">list</field>
    </record>

    <!-- KAIROS SCORING RULE (audit "motore vs conoscenza" 23/08/2026): prima
         dizionari Python in production_order.py, ora righe di questo
         modello, modificabili qui da un admin senza promote del modulo. -->
    <record id="view_kairos_scoring_rule_list" model="ir.ui.view">
        <field name="name">erpv6.kairos.scoring.rule.list</field>
        <field name="model">erpv6.kairos.scoring.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="indicator"/>
                <field name="answer_label"/>
                <field name="score"/>
                <field name="sequence" widget="handle"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_kairos_scoring_rule" model="ir.actions.act_window">
        <field name="name">Punteggi Kairós (intervista)</field>
        <field name="res_model">erpv6.kairos.scoring.rule</field>
        <field name="view_mode">list</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_production_root" name="Produzione" parent="erpv6_core.menu_erpv6_root" sequence="26"/>
    <menuitem id="menu_production_order" name="Produzioni" parent="menu_production_root" action="action_production_order" sequence="10"/>
    <menuitem id="menu_production_phase" name="Fasi (catalogo)" parent="menu_production_root" action="action_production_phase" sequence="20"/>
    <menuitem id="menu_kairos_scoring_rule" name="Punteggi Kairós" parent="menu_production_root" action="action_kairos_scoring_rule" sequence="30"/>
</odoo>
