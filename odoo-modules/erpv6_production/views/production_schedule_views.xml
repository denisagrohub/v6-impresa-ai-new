<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PRODUCTION SCHEDULE (coda di lavoro aggregata per risorsa) -->
    <record id="view_production_schedule_search" model="ir.ui.view">
        <field name="name">erpv6.production.schedule.search</field>
        <field name="model">erpv6.production.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="resource_id"/>
                <field name="phase_id"/>
                <field name="order_id"/>
                <filter string="Aperte" name="filter_open" domain="[('state', '!=', 'done')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Risorsa" name="group_resource" context="{'group_by': 'resource_id'}"/>
                    <filter string="Fase" name="group_phase" context="{'group_by': 'phase_id'}"/>
                    <filter string="Ordine" name="group_order" context="{'group_by': 'order_id'}"/>
                    <filter string="Stato" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_production_schedule_list" model="ir.ui.view">
        <field name="name">erpv6.production.schedule.list</field>
        <field name="model">erpv6.production.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="resource_id"/><field name="order_id"/><field name="phase_id"/>
                <field name="planned_hours" sum="Ore Totali"/>
                <field name="date_start"/><field name="date_end"/><field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_production_schedule_pivot" model="ir.ui.view">
        <field name="name">erpv6.production.schedule.pivot</field>
        <field name="model">erpv6.production.schedule</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="resource_id" type="row"/>
                <field name="phase_id" type="col"/>
                <field name="planned_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_production_schedule_calendar" model="ir.ui.view">
        <field name="name">erpv6.production.schedule.calendar</field>
        <field name="model">erpv6.production.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Coda di Lavoro" date_start="date_start" date_stop="date_end" color="resource_id" mode="week">
                <field name="order_id"/>
                <field name="phase_id"/>
                <field name="resource_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_production_schedule" model="ir.actions.act_window">
        <field name="name">Coda di Lavoro</field>
        <field name="res_model">erpv6.production.schedule</field>
        <field name="view_mode">list,pivot,calendar,form</field>
        <field name="context">{'search_default_filter_open': 1, 'search_default_group_resource': 1}</field>
    </record>

    <menuitem id="menu_production_schedule" name="Coda di Lavoro" parent="menu_production_root"
              action="action_production_schedule" sequence="15"/>
</odoo>
