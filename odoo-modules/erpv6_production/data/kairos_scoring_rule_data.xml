<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": stessi valori che prima erano nei dizionari Python
         _KAIROS_BUDGET_TO_IMPATTO/_KAIROS_BUDGET_TO_LIQUIDITA/
         _KAIROS_TEMPISTICHE_TO_URGENZA in production_order.py (corretto il
         23/08/2026, audit "motore vs conoscenza"): seme iniziale, un
         admin puo' modificarli da Impostazioni senza che un upgrade del
         modulo li sovrascriva. Le stringhe answer_label devono restare
         IDENTICHE alle opzioni in apps/impresa/src/app/intervista/page.tsx
         (vincolo tecnico reale, non spostato). -->
    <data noupdate="1">
        <record id="kairos_scoring_budget_impatto_1" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_impatto</field>
            <field name="answer_label">&lt; €5.000</field>
            <field name="score">2</field>
            <field name="sequence">10</field>
        </record>
        <record id="kairos_scoring_budget_impatto_2" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_impatto</field>
            <field name="answer_label">€5.000 - €10.000</field>
            <field name="score">3</field>
            <field name="sequence">20</field>
        </record>
        <record id="kairos_scoring_budget_impatto_3" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_impatto</field>
            <field name="answer_label">€10.000 - €25.000</field>
            <field name="score">4</field>
            <field name="sequence">30</field>
        </record>
        <record id="kairos_scoring_budget_impatto_4" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_impatto</field>
            <field name="answer_label">&gt; €25.000</field>
            <field name="score">5</field>
            <field name="sequence">40</field>
        </record>

        <record id="kairos_scoring_budget_liquidita_1" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_liquidita</field>
            <field name="answer_label">&lt; €5.000</field>
            <field name="score">1</field>
            <field name="sequence">10</field>
        </record>
        <record id="kairos_scoring_budget_liquidita_2" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_liquidita</field>
            <field name="answer_label">€5.000 - €10.000</field>
            <field name="score">2</field>
            <field name="sequence">20</field>
        </record>
        <record id="kairos_scoring_budget_liquidita_3" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_liquidita</field>
            <field name="answer_label">€10.000 - €25.000</field>
            <field name="score">2</field>
            <field name="sequence">30</field>
        </record>
        <record id="kairos_scoring_budget_liquidita_4" model="erpv6.kairos.scoring.rule">
            <field name="indicator">budget_liquidita</field>
            <field name="answer_label">&gt; €25.000</field>
            <field name="score">3</field>
            <field name="sequence">40</field>
        </record>

        <record id="kairos_scoring_tempistiche_urgenza_1" model="erpv6.kairos.scoring.rule">
            <field name="indicator">tempistiche_urgenza</field>
            <field name="answer_label">Immediata (&lt; 1 mese)</field>
            <field name="score">3</field>
            <field name="sequence">10</field>
        </record>
        <record id="kairos_scoring_tempistiche_urgenza_2" model="erpv6.kairos.scoring.rule">
            <field name="indicator">tempistiche_urgenza</field>
            <field name="answer_label">Breve (1-3 mesi)</field>
            <field name="score">3</field>
            <field name="sequence">20</field>
        </record>
        <record id="kairos_scoring_tempistiche_urgenza_3" model="erpv6.kairos.scoring.rule">
            <field name="indicator">tempistiche_urgenza</field>
            <field name="answer_label">Media (3-6 mesi)</field>
            <field name="score">2</field>
            <field name="sequence">30</field>
        </record>
        <record id="kairos_scoring_tempistiche_urgenza_4" model="erpv6.kairos.scoring.rule">
            <field name="indicator">tempistiche_urgenza</field>
            <field name="answer_label">Lunga (&gt; 6 mesi)</field>
            <field name="score">1</field>
            <field name="sequence">40</field>
        </record>

        <!-- Valore neutro (prima _KAIROS_NEUTRO = 2 in Python) per gli
             indicatori senza segnale diretto nell'intervista attuale. -->
        <record id="kairos_neutro_score_param" model="ir.config_parameter">
            <field name="key">erpv6_production.kairos_neutro_score</field>
            <field name="value">2</field>
        </record>
    </data>
</odoo>
