<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_production_evaluate_all" model="ir.cron">
            <field name="name">Valuta Avanzamento Produzioni - Ogni 30 minuti</field>
            <field name="model_id" ref="model_erpv6_production_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_evaluate_all()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Retry automatico su documenti KB falliti per rate limit Groq
             transitorio (checkpoint-safe, vedi _cron_retry_kb_extraction_failures
             in library_document.py): 15 minuti, abbastanza per superare il
             circuit breaker di 5 minuti del provider (CHUNK_RATE_LIMIT_WAIT_SECONDS
             in kb_extraction_service.py) senza martellare inutilmente. -->
        <record id="cron_retry_kb_extraction_failures" model="ir.cron">
            <field name="name">Retry Automatico Estrazione KB Fallita (rate limit transitorio) - Ogni 15 minuti</field>
            <field name="model_id" ref="model_erpv6_library_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_kb_extraction_failures()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Consolida in UN certificato per categoria tutte le voci KB
             approvate nell'ultima ora, invece di uno per ogni click separato
             di "Valida" (vedi
             validation_session.py/_cron_send_consolidated_kb_certificates,
             segnalato dal vivo dall'utente il 20/08/2026). -->
        <record id="cron_send_consolidated_kb_certificates" model="ir.cron">
            <field name="name">Certificato Validazione KB Consolidato - Ogni ora</field>
            <field name="model_id" ref="erpv6_production.model_erpv6_validation_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_consolidated_kb_certificates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <!-- user_id=administrator, non il default OdooBot: questo cron
                 manda email (action_notify_user), e OdooBot ha come azienda
                 di default "My Company" (mai rinominata): stesso fix di
                 erpv6_kaizen/data/kaizen_cron.xml, stesso bug segnalato dal
                 vivo dall'utente il 20/08/2026. -->
            <field name="user_id" ref="base.user_admin"/>
        </record>
    </data>
</odoo>
