<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="circuit_comunicazioni_progetti" model="erpv6.core.node">
            <field name="name">Circuito Comunicazioni Progetti</field>
            <field name="parent_id" ref="erpv6_core_engine.circuit_workspace_root"/>
            <field name="is_composite" eval="True"/>
            <field name="circuit_role">generico</field>
        </record>

        <record id="node_route_project_email" model="erpv6.core.node">
            <field name="name">Instrada Email Progetto</field>
            <field name="parent_id" ref="circuit_comunicazioni_progetti"/>
            <field name="sequence">10</field>
            <field name="process_key">route_project_email</field>
            <field name="input_format">json</field>
        </record>

        <record id="node_create_project_node" model="erpv6.core.node">
            <field name="name">Crea Nodo Progetto/Parte</field>
            <field name="parent_id" ref="circuit_comunicazioni_progetti"/>
            <field name="sequence">20</field>
            <field name="process_key">create_project_node</field>
            <field name="input_format">json</field>
        </record>

        <record id="input_spec_route_to" model="erpv6.core.process.input_spec">
            <field name="process_key">route_project_email</field>
            <field name="input_key">to</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
            <field name="note">Intestazione To/Cc grezza dell'email in ingresso.</field>
        </record>

        <record id="input_spec_create_name" model="erpv6.core.process.input_spec">
            <field name="process_key">create_project_node</field>
            <field name="input_key">name</field>
            <field name="tipo_dato">testo</field>
            <field name="obbligatorio" eval="True"/>
            <field name="note">Nome del nodo erpv6.tracking.relation da creare.</field>
        </record>

    </data>
</odoo>
