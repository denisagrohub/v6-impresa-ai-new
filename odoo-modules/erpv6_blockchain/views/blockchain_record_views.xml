<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blockchain_record_list" model="ir.ui.view">
        <field name="name">erpv6.blockchain.record.list</field>
        <field name="model">erpv6.blockchain.record</field>
        <field name="arch" type="xml">
            <list string="Record Blockchain" decoration-success="status=='confirmed'" decoration-danger="status=='failed'">
                <field name="document_name"/>
                <field name="lot_number"/>
                <field name="document_hash"/>
                <field name="tx_hash"/>
                <field name="status"/>
                <field name="timestamp"/>
            </list>
        </field>
    </record>

    <record id="view_blockchain_record_form" model="ir.ui.view">
        <field name="name">erpv6.blockchain.record.form</field>
        <field name="model">erpv6.blockchain.record</field>
        <field name="arch" type="xml">
            <form string="Record Blockchain">
                <header>
                    <button name="action_certify" string="Certifica su Blockchain" type="object" class="oe_highlight" invisible="status != 'pending'"/>
                    <button name="action_verify" string="Verifica Stato" type="object" invisible="not tx_hash"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Dati Documento">
                            <field name="document_model"/>
                            <field name="document_id"/>
                            <field name="document_name"/>
                            <field name="lot_number"/>
                            <field name="document_hash"/>
                        </group>
                        <group string="Dati Blockchain">
                            <field name="config_id"/>
                            <field name="tx_hash" widget="url"/>
                            <field name="block_number"/>
                            <field name="gas_used"/>
                            <field name="gas_cost_eth"/>
                            <field name="verification_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Errore" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_blockchain_record" model="ir.actions.act_window">
        <field name="name">Record Certificati</field>
        <field name="res_model">erpv6.blockchain.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>