<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_blockchain_config_list" model="ir.ui.view">
        <field name="name">erpv6.blockchain.config.list</field>
        <field name="model">erpv6.blockchain.config</field>
        <field name="arch" type="xml">
            <list string="Configurazioni Blockchain">
                <field name="name"/>
                <field name="provider"/>
                <field name="network" invisible="provider != 'polygon'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_blockchain_config_form" model="ir.ui.view">
        <field name="name">erpv6.blockchain.config.form</field>
        <field name="model">erpv6.blockchain.config</field>
        <field name="arch" type="xml">
            <form string="Configurazione Blockchain">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome Configurazione"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Provider e Stato">
                            <field name="provider"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Polygon / EVM (solo se provider=polygon)"
                           invisible="provider != 'polygon'">
                        <field name="network"/>
                        <field name="rpc_url" widget="url"/>
                        <field name="private_key" password="True"/>
                        <field name="contract_address"/>
                        <field name="gas_limit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_blockchain_config" model="ir.actions.act_window">
        <field name="name">Configurazioni Blockchain</field>
        <field name="res_model">erpv6.blockchain.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
