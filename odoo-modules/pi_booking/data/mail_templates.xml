<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template email di conferma prenotazione -->
        <record id="email_booking_confirmation" model="mail.template">
            <field name="name">PI: Conferma Prenotazione</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">✅ Conferma appuntamento: {{ object.name }} - {{ object.start.strftime('%d/%m/%Y alle %H:%M') }}</field>
            <field name="email_from">{{ (object.company_id.email or 'info@progettoimpresa.it') }}</field>
            <field name="email_to">{{ object.x_pi_client_email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; background: #f8fafc; padding: 20px;">
    <div style="background: #1a2744; color: white; padding: 20px; border-radius: 8px 8px 0 0;">
        <h1 style="margin: 0; font-size: 24px;">Progetto Impresa</h1>
        <p style="margin: 5px 0 0; opacity: 0.9;">Conferma Appuntamento</p>
    </div>
    
    <div style="background: white; padding: 30px; border-radius: 0 0 8px 8px;">
        <p style="font-size: 16px; color: #1a2744;">
            Gentile <strong>{{ object.x_pi_client_name or 'Cliente' }}</strong>,
        </p>
        
        <p>La tua prenotazione è stata confermata. Ecco i dettagli:</p>
        
        <table style="width: 100%; background: #f8fafc; border-radius: 8px; padding: 15px; margin: 20px 0;">
            <tr>
                <td style="padding: 8px 0; color: #64748b;">📅 Data:</td>
                <td style="padding: 8px 0; font-weight: bold;">{{ object.start.strftime('%d/%m/%Y') }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 0; color: #64748b;">⏰ Ora:</td>
                <td style="padding: 8px 0; font-weight: bold;">{{ object.start.strftime('%H:%M') }}</td>
            </tr>
            <tr>
                <td style="padding: 8px 0; color: #64748b;">⏱️ Durata:</td>
                <td style="padding: 8px 0; font-weight: bold;">{{ '{0}'.format(int((object.stop - object.start).total_seconds() / 60)) }} minuti</td>
            </tr>
            <tr>
                <td style="padding: 8px 0; color: #64748b;">👤 Consulente:</td>
                <td style="padding: 8px 0; font-weight: bold;">{{ object.x_pi_consultant_id.name or 'Da assegnare' }}</td>
            </tr>
            % if object.x_pi_meeting_link:
            <tr>
                <td style="padding: 8px 0; color: #64748b;">🔗 Link Call:</td>
                <td style="padding: 8px 0;">
                    <a href="{{ object.x_pi_meeting_link }}" style="color: #f97316; font-weight: bold;">
                        Accedi alla video call
                    </a>
                </td>
            </tr>
            % endif
        </table>
        
        % if object.description:
        <div style="background: #fff7ed; border-left: 4px solid #f97316; padding: 15px; margin: 20px 0;">
            <strong>Note:</strong><br/>
            {{ object.description }}
        </div>
        % endif
        
        <p>Riceverai un reminder 24 ore prima dell'appuntamento.</p>
        
        <p style="margin-top: 30px; color: #64748b; font-size: 14px;">
            A presto,<br/>
            <strong>Il Team di Progetto Impresa</strong>
        </p>
    </div>
    
    <div style="text-align: center; padding: 20px; color: #94a3b8; font-size: 12px;">
        © 2026 Progetto Impresa S.r.l. | info@progettoimpresa.it
    </div>
</div>
            ]]>            </field>
        </record>

        <!-- Template notifica al consulente -->
        <record id="email_consultant_notification" model="mail.template">
            <field name="name">PI: Notifica Consulente Nuova Prenotazione</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">🔔 Nuova prenotazione: {{ object.x_pi_client_name }} - {{ object.start.strftime('%d/%m/%Y %H:%M') }}</field>
            <field name="email_from">{{ (object.company_id.email or 'info@progettoimpresa.it') }}</field>
            <field name="email_to">{{ object.x_pi_consultant_id.email or '' }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto;">
    <h2 style="color: #1a2744;">🔔 Nuova Prenotazione Ricevuta</h2>
    
    <p>Ciao <strong>{{ object.x_pi_consultant_id.name or 'Consulente' }}</strong>,</p>
    
    <p>Hai ricevuto una nuova prenotazione dal sito web:</p>
    
    <table style="width: 100%; background: #f8fafc; border-radius: 8px; padding: 15px;">
        <tr>
            <td><strong>Cliente:</strong></td>
            <td>{{ object.x_pi_client_name }}</td>
        </tr>
        <tr>
            <td><strong>Email:</strong></td>
            <td>{{ object.x_pi_client_email }}</td>
        </tr>
        <tr>
            <td><strong>Telefono:</strong></td>
            <td>{{ object.x_pi_client_phone or '-' }}</td>
        </tr>
        <tr>
            <td><strong>Data/Ora:</strong></td>
            <td>{{ object.start.strftime('%d/%m/%Y alle %H:%M') }}</td>
        </tr>
        <tr>
            <td><strong>Note:</strong></td>
            <td>{{ object.x_pi_notes or '-' }}</td>
        </tr>
    </table>
    
    <p style="margin-top: 20px;">
        <a href="/web#id={{ object.id }}&view_type=form&model=calendar.event" style="background: #f97316; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; display: inline-block;">
            Vedi in Odoo
        </a>
    </p>
</div>
            ]]>            </field>
        </record>

        <!-- Sorgente CRM per booking pubblici -->
        <record id="source_booking_public" model="utm.source">
            <field name="name">Booking Pubblico (Sito Web)</field>
        </record>
    </data>
</odoo>