<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deduction_suggestion_form" model="ir.ui.view">
        <field name="name">erpv6.deduction.suggestion.form</field>
        <field name="model">erpv6.deduction.suggestion</field>
        <field name="arch" type="xml">
            <form string="Suggerimento Deduzione">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="category" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Categoria">
                            <field name="category"/>
                            <field name="priority"/>
                            <field name="status"/>
                        </group>
                        <group string="Dati Finanziari">
                            <field name="max_deductible"/>
                            <field name="current_in_stock"/>
                            <field name="suggested_purchase"/>
                            <field name="tax_savings"/>
                        </group>
                    </group>
                    <group>
                        <group string="Deduzione">
                            <field name="deduction_rate"/>
                            <field name="tax_rate"/>
                        </group>
                        <group string="Inventario">
                            <field name="stock_quantity"/>
                            <field name="stock_product_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Dettagli">
                        <field name="description"/>
                        <field name="deadline"/>
                    </group>
                    <footer>
                        <button name="action_create_purchase_order" string="Crea Ordine Acquisto" type="object" class="oe_highlight"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deduction_suggestion_list" model="ir.ui.view">
        <field name="name">erpv6.deduction.suggestion.list</field>
        <field name="model">erpv6.deduction.suggestion</field>
        <field name="arch" type="xml">
            <list string="Suggerimenti Deduzioni">
                <field name="category"/>
                <field name="max_deductible"/>
                <field name="suggested_purchase"/>
                <field name="tax_savings"/>
                <field name="priority"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_deduction_suggestion" model="ir.actions.act_window">
        <field name="name">Suggerimenti Deduzioni</field>
        <field name="res_model">erpv6.deduction.suggestion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>