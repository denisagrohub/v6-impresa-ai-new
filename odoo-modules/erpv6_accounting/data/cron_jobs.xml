<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job per ricalcolo automatico previsioni fiscali (opzionale, disattivato di default) -->
        <record id="ir_cron_recalculate_predictions" model="ir.cron">
            <field name="name">V6: Ricalcolo Previsioni Fiscali (Bozze)</field>
            <field name="model_id" ref="model_erpv6_fiscal_prediction"/>
            <field name="state">code</field>
            <field name="code">model.search([('state', '=', 'draft')]).action_calculate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>