# ============================================
# CONFIGURAZIONE SISTEMA PROGETTO IMPRESA
# ============================================

#  FLAG PRINCIPALE: true = usa Odoo, false = usa database locale
NEXT_PUBLIC_USE_ODOO=false

# Brand attivo di default (multi-tenant)
# Valori: progetto-impresa | zero-sprechi | manuale-rapido
NEXT_PUBLIC_ACTIVE_BRAND=progetto-impresa

# ============================================
# CONFIGURAZIONE ODOO (solo se USE_ODOO=true)
# ============================================
NEXT_PUBLIC_ODOO_URL=https://agrohub.odoo.com
NEXT_PUBLIC_ODOO_DB=agrohub
ODOO_API_KEY=your-odoo-api-key-here

# ============================================
# WHITE-LABEL (opzionale)
# ============================================
NEXT_PUBLIC_WHITELABEL=false
NEXT_PUBLIC_PARTNER_ID=

# ============================================
# ALTRE CONFIGURAZIONI
# ============================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_STRIPE_KEY=